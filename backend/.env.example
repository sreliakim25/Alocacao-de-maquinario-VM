# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Autenticação JWT ──────────────────────────────────────────────────────────
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── CORS — Frontend ───────────────────────────────────────────────────────────
# URL exata do seu app no Vercel (sem barra no final)
FRONTEND_URL=https://seu-projeto.vercel.app

# Nome do projeto no Vercel (para aceitar preview deploys automaticamente)
# Ex: se o projeto se chama "meu-app", as previews ficam em "meu-app-git-branch-user.vercel.app"
VERCEL_PROJECT=seu-projeto

# ── Email — Resend (resend.com) ───────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Sistema de Maquinários VM <noreply@rochadev.com>
